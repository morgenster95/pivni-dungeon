{
  "name": "pivni-dungeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pivni-dungeon \"vitest run tests/rules\"",
    "test:layout": "playwright test"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "firebase": "^10.14.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "postcss-import": "^17.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
